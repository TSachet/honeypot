# Copier ce fichier en ".env" (non versionné) et adapter les valeurs.

# Interface d'écoute : 0.0.0.0 = toutes les interfaces (obligatoire pour Docker)
BIND_HOST=0.0.0.0

# Ports d'écoute (conteneur / machine locale)
PORT_HTTP=8080
PORT_SSH=2222
PORT_FTP=2121
PORT_REDIS=6379
PORT_MYSQL=3306
PORT_TELNET=2323
PORT_SMTP=2525
PORT_POP3=1110
PORT_LDAP=3890
PORT_RDP=3389
PORT_POSTGRESQL=5432

# Multiplexeur (payload detection) : un port unique qui devine le protocole
MUX_ENABLED=true
PORT_MUX=9000
# Service utilisé si le client reste muet (protocoles où le serveur parle en premier)
MUX_DEFAUT=FTP
# Délai (secondes) d'attente du premier paquet du client
MUX_DELAI=2.0

# Journal des attaques (JSON Lines). Relatif à la racine du projet ou absolu.
LOG_FILE=logs/events.jsonl

# SSH : "simulate" (réponses simulées, sans rien exécuter) ou "docker" (docker exec dans sandbox_generique)
SSH_SANDBOX=simulate

# --- Docker Compose : ports publiés sur la machine hôte (ports "réels" pour paraître crédible) ---
HOST_PORT_HTTP=80
HOST_PORT_SSH=22
HOST_PORT_FTP=21
HOST_PORT_REDIS=6379
HOST_PORT_MYSQL=3306
HOST_PORT_TELNET=23
HOST_PORT_SMTP=25
HOST_PORT_POP3=110
HOST_PORT_LDAP=389
HOST_PORT_RDP=3389
HOST_PORT_POSTGRESQL=5432
HOST_PORT_MUX=9000
